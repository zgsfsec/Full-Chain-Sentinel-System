{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sentinel intelligence ingest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "events"],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "$ref": "#/$defs/id" },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "indicator", "occurred_at", "category", "severity", "evidence"],
        "properties": {
          "event_id": { "$ref": "#/$defs/id" },
          "indicator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value"],
            "properties": {
              "type": { "const": "ip" },
              "value": { "type": "string", "maxLength": 64, "oneOf": [{ "format": "ipv4" }, { "format": "ipv6" }] }
            }
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "maxLength": 40,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "category": { "$ref": "#/$defs/id" },
          "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
          "evidence": { "type": "object", "description": "Serialized JSON <=16000 characters; nested objects/arrays <=20 levels. Validated by server." }
        }
      }
    }
  },
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" } }
}
