{
	"name": "@earendil-works/sentinel-web",
	"version": "2.3.0",
	"private": true,
	"type": "module",
	"description": "Full Chain Sentinel web console: HTTP + WebSocket server and browser UI for the penetration testing agent",
	"bin": {
		"sentinel-web": "dist/index.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"clean": "shx rm -rf dist webui/dist",
		"build": "npm run build:official && npm run build:webui && node scripts/generate-embedded-assets.mjs && tsc -p tsconfig.json",
		"build:webui": "vite build webui",
		"build:assets": "node scripts/generate-embedded-assets.mjs",
		"build:binary": "bash ../../scripts/build-web-binaries.sh",
		"check:webui": "tsc -p webui/tsconfig.json --noEmit",
		"test": "vitest --run",
		"start": "node dist/index.js",
		"plugin-host": "node src/index.ts plugin-host",
		"build:official": "node scripts/generate-official-plugins.mjs"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^1.1.0",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"ws": "8.22.0",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@ant-design/cssinjs": "2.1.2",
		"@ant-design/icons": "6.3.4",
		"@ant-design/pro-components": "3.1.15-8",
		"@types/qrcode": "1.5.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/ws": "8.18.2",
		"@vitejs/plugin-react": "6.1.2",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/xterm": "6.0.0",
		"antd": "6.6.8",
		"dayjs": "1.11.23",
		"lucide-react": "1.54.0",
		"qrcode": "1.5.4",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"shx": "0.3.4",
		"swagger-ui-dist": "5.33.2",
		"vite": "8.3.4"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
